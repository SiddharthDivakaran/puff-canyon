{
  "name": "puff-canyon",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "LEADERBOARD", "class_name": "PuffLeaderboard" }]
  },
  "migrations": [{ "tag": "v1-leaderboard", "new_sqlite_classes": ["PuffLeaderboard"] }]
}
